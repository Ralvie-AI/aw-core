{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "User",
	"description": "The Event model that is used in Sundial",
	"type": "object",
	"required": ["email", "password"],
	"properties": {
		"email": {
            "type": "string",
            "format": "email"
		},
		"password": {
            "type": "string"
		}
	}
}
